PORT=5000

# Option 1: Local MongoDB (default)
# MONGO_URI=mongodb://127.0.0.1:27017/college_lost_found

# Option 2: MongoDB Atlas (cloud) - paste your own connection string
# Note the database name (college_lost_found) before the "?"
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.xxxxx.mongodb.net/college_lost_found?retryWrites=true&w=majority&appName=<cluster-name>

JWT_SECRET=replace_with_a_long_random_secret
