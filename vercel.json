{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "college-lost-found/client",
      "framework": "vite"
    },
    "api": {
      "root": "college-lost-found/server",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/(.*\\.[a-zA-Z0-9]+)",
      "destination": {
        "service": "web",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    }
  ],
